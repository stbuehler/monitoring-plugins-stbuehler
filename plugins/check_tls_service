class GenericSSLClient:
    def __init__(
        self,
        *,
        context: OpenSSL.SSL.Context,
        stream: AbstractSocket,
        server_hostname: str | None = None,  # SNI
        session: OpenSSL.SSL.Session | None = None,
    ) -> None:
        self._stream = stream
        self._outgoing_closed = False
        self._incoming_closed = False
        self._incoming_buf = b""
        self._ssl = OpenSSL.SSL.Connection(context)
        if server_hostname:
            self._ssl.set_tlsext_host_name(server_hostname.encode('idna'))
        if session:
            self._ssl.set_session(session)
        self._ssl.set_connect_state()

    def _flush_outgoing(self) -> None:
        while True:
            if not self._outgoing_closed:
                try:
                    data = self._ssl.bio_read(4096)
                    self._stream.sendall(data)
                except OpenSSL.SSL.WantReadError:
                    return  # nothing pending
            else:
                # clear buffer
                self._ssl.bio_read(4096)

    def _flush_incoming(self) -> None:
        while self._incoming_buf:
            try:
                written = self._ssl.bio_write(self._incoming_buf)
            except OpenSSL.SSL.WantReadError:
                return
            self._incoming_buf = self._incoming_buf[written:]

    def _repeat_with_bio[T](self, callable: typing.Callable[[], T], /) -> T:
        while True:
            want_read = False
            try:
                result = callable()
                break
            except OpenSSL.SSL.WantWriteError:
                # we always flush outgoing
                # retry in next iteration
                pass
            except OpenSSL.SSL.WantReadError:
                want_read = True

            self._flush_outgoing()
            if want_read:
                if self._incoming_closed:
                    raise RuntimeError("caught SSLWantReadError but stream already closed")
                if self._incoming_buf:
                    self._flush_incoming()
                    continue
                try:
                    self._incoming_buf = self._stream.recv(4096)
                    if not self._incoming_buf:
                        raise EOFError()
                except EOFError:
                    self._incoming_closed = True
                    self._ssl.bio_shutdown()
                else:
                    self._flush_incoming()

        self._flush_outgoing()

        return result

    @property
    def context(self) -> OpenSSL.SSL.Context:
        return self._ssl.get_context()

    @property
    def session(self) -> OpenSSL.SSL.Session | None:
        return self._ssl.get_session()

    def cipher(self) -> tuple[str, str, int] | None:
        name = self._ssl.get_cipher_name()
        version = self._ssl.get_cipher_version()
        bits = self._ssl.get_cipher_bits()
        if name is None or version is None or bits is None:
            return None
        return (name, version, bits)

    def pending(self) -> int:
        return self._ssl.pending()

    def renegotiate(self) -> bool:
        return self._ssl.renegotiate()

    def do_handshake(self) -> None:
        try:
            return self._repeat_with_bio(lambda: self._ssl.do_handshake())
        except OpenSSL.SSL.Error as exc:
            reasons = ", ".join(reason
                for _lib, _function, reason in exc.args[0]
            )
            RESULT.critical(
                f"Failed TLS handshake: {type(exc).__name__}: {reasons}",
                abort=not self.get_peer_cert_chain(),
            )

    def version(self) -> str:
        return self._ssl.get_protocol_version_name()

    def get_peer_cert_chain(self) -> list[cryptography.x509.Certificate] | None:
        certs = self._ssl.get_peer_cert_chain()
        if certs is None:
            return None
        return [cert.to_cryptography() for cert in certs]

    # IO

    def recv(self, bufsize: int, /, flags: int = 0) -> bytes:
        return self._repeat_with_bio(lambda: self._ssl.recv(bufsize))

    def sendall(self, data: bytes | memoryview | bytearray, /, flags: int = 0) -> None:
        self._repeat_with_bio(lambda: self._ssl.sendall(data))

    def close(self) -> None:
        self._ssl.write_eof()
        self._outgoing_closed = True
        self._flush_outgoing()
        self._stream.close()

    def shutdown(self, how: int) -> None:
        self._repeat_with_bio(lambda: self._ssl.unwrap())


@dataclasses.dataclass(slots=True, kw_only=True)
class Option:
    help: str
    action: str
    converter: typing.Callable[[str], typing.Any] | None
    required: bool
    aliases: tuple[str, ...]
    metavar: str

    @staticmethod
    def _make[T](
        *,
        default: T | dataclasses._MISSING_TYPE,
        default_factory: typing.Callable[[], T] | dataclasses._MISSING_TYPE = dataclasses.MISSING,
        help: str,
        action: str = "store",
        converter: typing.Callable[[str], typing.Any] | None = None,
        required: bool = False,
        metavar: str = "",
        aliases: typing.Sequence[str],
    ) -> T:
        metadata = {id(Option): Option(
            help=help,
            action=action,
            converter=converter,
            required=required,
            aliases=tuple(aliases),
            metavar=metavar,
        )}
        return dataclasses.field(
            default=default,
            default_factory=default_factory,  # type: ignore
            metadata=metadata,
        )

    @staticmethod
    def from_str[T](
        *,
        default: T,
        converter: typing.Callable[[str], typing.Any],
        aliases: typing.Sequence[str] = (),
        metavar: str = "",
        help: str,
    ) -> T:
        return Option._make(
            default=default,
            help=help,
            converter=converter,
            required=False,
            metavar=metavar,
            aliases=tuple(aliases),
        )

    @staticmethod
    def simple_str(
        *,
        default: str = "",
        required: bool = False,
        aliases: typing.Sequence[str] = (),
        metavar: str = "",
        help: str,
    ) -> str:
        return Option._make(
            default=default,
            help=help,
            converter=str,
            required=required,
            metavar=metavar,
            aliases=tuple(aliases),
        )

    @staticmethod
    def multi_str(
        *,
        aliases: typing.Sequence[str] = (),
        metavar: str = "",
        help: str,
    ) -> list[str]:
        return Option._make(
            default=dataclasses.MISSING,
            default_factory=list,
            help=help,
            action="append",
            required=False,
            metavar=metavar,
            aliases=tuple(aliases),
        )

    @staticmethod
    def flag(
        *,
        default: bool = False,
        aliases: typing.Sequence[str] = (),
        help: str,
    ) -> bool:
        return Option._make(
            default=default,
            help=help,
            converter=None,
            action="store_false" if default else "store_true",
            aliases=tuple(aliases),
        )

    @staticmethod
    def count(
        *,
        aliases: typing.Sequence[str] = (),
        help: str,
    ) -> int:
        return Option._make(
            default=0,
            help=help,
            converter=None,
            action="count",
            aliases=tuple(aliases),
        )


@dataclasses.dataclass
class Arguments:
    @staticmethod
    def _add_opt_from_field(parser: argparse.ArgumentParser, field: dataclasses.Field) -> None:
        option = field.metadata[id(Option)]
        assert isinstance(option, Option)
        kwargs: dict[str, typing.Any] = dict(
            action=option.action,
            dest=field.name,
            required=option.required,
            help=option.help,
        )
        if option.converter:
            kwargs['type'] = option.converter
        if not field.default is None and not field.default is dataclasses.MISSING:
            if isinstance(field.default, (bool, int)):
                kwargs['default'] = field.default
            else:
                kwargs['default'] = str(field.default)
        if option.metavar:
            kwargs["metavar"] = option.metavar
        if option.aliases and not option.aliases[0]:
            flags = option.aliases[1:]
        else:
            flags = (
                f"--{field.name.strip('_').replace('_', '-')}",
                *option.aliases,
            )
        if field.name.startswith('_'):
            kwargs["help"] = argparse.SUPPRESS
        parser.add_argument(
            *flags,
            **kwargs,
        )

    @staticmethod
    def parse_args():
        parser = argparse.ArgumentParser(allow_abbrev=False)
        for field in dataclasses.fields(Arguments):
            if field.name == "host":
                # host can also be specified without leading "-H"
                host_group = parser.add_mutually_exclusive_group()
                host_group.add_argument("hostarg", metavar="HOST", nargs='?', help="Please specify the server using --host/-H instead")
                Arguments._add_opt_from_field(host_group, field)
            else:
                Arguments._add_opt_from_field(parser, field)

        try:
            args = parser.parse_args()
        except SystemExit:
            import shlex
            print("Called as: " + shlex.join(sys.argv))
            raise

        hostarg = args.__dict__.pop("hostarg", None)
        if not hostarg is None:
            assert not args.host
            args.host = hostarg
        if not args.host:
            RESULT.critical("Missing --host argument")
        return Arguments(**args.__dict__)

