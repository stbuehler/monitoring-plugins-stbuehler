class AbstractSocket(typing.Protocol):
    def recv(self, bufsize: int, /, flags: int = 0) -> bytes:
        ...

    def sendall(self, data: bytes, /, flags: int = 0) -> None:
        ...

    def close(self) -> None:
        ...

    def shutdown(self, how: int) -> None:
        ...


class BufferedSocket:
    def __init__(self, stream: AbstractSocket, /) -> None:
        self._socket = stream
        self._buffer = bytearray()
        self._got_eof = False

    @staticmethod
    def create_connection(host: str, port: int) -> BufferedSocket:
        stream = socket.create_connection((host, port))
        return BufferedSocket(stream)

    def _fill_buffer(self) -> None:
        if self._got_eof:
            raise EOFError()
        try:
            data = self._socket.recv(1024)
            if len(data) == 0:
                raise EOFError()
            self._buffer += data
        except EOFError:
            self._got_eof = True
            raise

    def _take_buffer(self, bufsize: int = -1) -> bytes:
        if bufsize < 0 or bufsize >= len(self._buffer):
            result = bytes(self._buffer)
            self._buffer.clear()
        else:
            result = bytes(self._buffer[:bufsize])
            self._buffer = self._buffer[bufsize:]
        return result

    def peek(self, lookahead: int) -> bytes:
        # returned data is at least `lookahead` bytes long, fail on EOF
        while len(self._buffer) < lookahead:
            self._fill_buffer()
        return bytes(self._buffer)

    def peek_further(self) -> bytes:
        # get at least one additional byte, fail on EOF
        self._fill_buffer()
        return bytes(self._buffer)

    def recv_line(self, bufsize: int, /, *, separator: bytes = b'\n') -> bytes:
        # returns (non-empty) final line without separator on EOF, otherwise separator is included
        while True:
            try:
                pos = self._buffer.index(separator)
            except ValueError:
                pass
            else:
                return self._take_buffer(pos + len(separator))
            # separator not found: need more data
            if len(self._buffer) >= bufsize:
                raise ValueError(f"Couldn't find separator in first {bufsize} of received data")
            try:
                self._fill_buffer()
            except EOFError:
                # ignore EOF if we have (non-empty) "partial" line (without separator at end)
                if self._buffer:
                    return self._take_buffer()
                raise

    def recv(self, bufsize: int, /, flags: int = 0) -> bytes:
        if self._buffer:
            return self._take_buffer(bufsize)
        if self._got_eof:
            return b""
        data = self._socket.recv(bufsize, flags)
        if len(data) == 0:
            self._got_eof = True
        return data

    def recv_exact(self, size: int) -> bytes:
        data = b""
        while len(data) < size:
            data += self.recv(size - len(data))
        return data

    def sendall(self, data: bytes, /, flags: int = 0) -> None:
        self._socket.sendall(data, flags)

    def close(self) -> None:
        self._socket.close()

    def shutdown(self, how: int) -> None:
        self._socket.shutdown(how)


