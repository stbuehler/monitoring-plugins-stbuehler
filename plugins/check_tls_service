def tls_connect(args: Arguments, context: OpenSSL.SSL.Context) -> GenericSSLClient:
    try:
        stream = BufferedSocket(connect(args))
    except TimeoutError:
        RESULT.critical(f"Timeout when trying to connect to TCP [{args.host}]:{args.actual_port}")
    starttls = args.protocol.starttls()
    if starttls:
        try:
            new_stream = starttls(args, stream)
            if not new_stream is None:
                stream = new_stream
        except TimeoutError:
            RESULT.critical(f"Timeout during STARTTLS with [{args.host}]:{args.actual_port}")
    server_hostname: str | None
    if args.sni:
        server_hostname = args.sni
    else:
        server_hostname = None
        try:
            ipaddress.ip_address(args.host)
        except ValueError:
            # only set non-IP host as SNI
            server_hostname = args.host
    return GenericSSLClient(context=context, stream=stream, server_hostname=server_hostname)


def get_x509_extensions(cert: OpenSSL.crypto.X509) -> dict[str, list[OpenSSL.crypto.X509Extension]]:
    extensions: dict[str, list[OpenSSL.crypto.X509Extension]] = {}
    for ndx in range(0, cert.get_extension_count()):
        ext = cert.get_extension(ndx)
        extensions.setdefault(ext.get_short_name().decode('ascii'), []).append(ext)
    return extensions


DNS_SINGLE_LABEL = re.compile(r'^[a-zA-Z0-9_\-]+$')


def name_matches(expected: str, allowed: str) -> bool:
    if expected == allowed:
        return True
    if (
        allowed.startswith('*.')  # wildcard SAN
        and expected.endswith(allowed[1:])  # in subdomain
        and DNS_SINGLE_LABEL.match(expected.removesuffix(allowed[1:]))  # only one label matches the *
    ):
        return True
    # TODO:
    # the check_ssl_cert shell script also tried using `name` as regex and matching allowed_name;
    # given hostnames contain lots of dots ('.') that seems unwise to accept.
    # maybe only with special syntax like a '/' prefix/wrapping?
    return False


def verify_peer_names(args: Arguments, peer_cert: cryptography.x509.Certificate) -> None:
    title = peer_cert.subject.rfc4514_string()
    cns = peer_cert.subject.get_attributes_for_oid(cryptography.x509.oid.NameOID.COMMON_NAME)
    cn: str | None = None
    if len(cns) == 1 and cns[0]:
        if isinstance(cns[0].value, bytes):
            try:
                cn = cns[0].value.decode("ascii")
            except ValueError:
                RESULT.warning(f"Only ASCII common names supported as SubjectAlternativeName fallback; ignoring common name")
        else:
            cn = cns[0].value
    using_cn = False
    names: list[cryptography.x509.GeneralName] = []
    if not args.ignore_altnames:
        try:
            names = list(peer_cert.extensions.get_extension_for_class(cryptography.x509.SubjectAlternativeName).value)
            if not names:
                RESULT.critical(f"SubjectAlternativeName extension present but empty in peer certificate {title}", abort=False)
                return
            for san_name in names:
                RESULT.message(f"SAN: {san_name.value}")
        except cryptography.x509.ExtensionNotFound:
            pass
    if not names:
        if not (args.ignore_altnames or args.allow_empty_san):
            RESULT.critical(f"Missing SubjectAlternativeName extension in peer certificate {title}", abort=False)
            return
        if not cn:
            RESULT.critical(f"Not exactly one common name in peer certificate subject: {title}", abort=False)
            return

        # fake SAN data
        using_cn = True
        names = [cryptography.x509.DNSName(cn)]

    for name in args.match:
        ip: ipaddress.IPv4Address | ipaddress.IPv6Address | None
        try:
            ip = ipaddress.ip_address(name)
        except ValueError:
            ip = None

        if ip is None:
            for allowed_name in names:
                if isinstance(allowed_name, cryptography.x509.DNSName):
                    if name_matches(name, allowed_name.value):
                        break
            else:
                if not using_cn and cn and name_matches(name, cn):
                    RESULT.warning(f"Certificate {title} not valid for {name} (CN would match but SAN present; could try --ignore-altnames)")
                else:
                    RESULT.critical(f"Certificate {title} not valid for {name}", abort=False)
        else:
            for allowed_name in names:
                if isinstance(allowed_name, cryptography.x509.IPAddress):
                    if isinstance(allowed_name.value, (ipaddress.IPv4Network, ipaddress.IPv6Network)):
                        if ip in allowed_name.value:
                            break
                    else:
                        assert isinstance(allowed_name.value, (ipaddress.IPv4Address, ipaddress.IPv6Address))
                        if ip == allowed_name.value:
                            break
            else:
                RESULT.critical(f"Certificate not valid for IP {name}", abort=False)


@dataclasses.dataclass
class CacheEntry:
    url: str
    last_modified: datetime.datetime
    etag: str
    age: datetime.timedelta
    data: bytes

    @staticmethod
    def _read(read_obj: typing.BinaryIO) -> CacheEntry | None:
        try:
            try:
                url = read_obj.readline().removesuffix(b"\n").decode()
            except UnicodeDecodeError:
                RESULT.warning("Can't decode URL from cache file")
                return None
            fstat = os.fstat(read_obj.fileno())
            hdr_begin = read_obj.tell()
            if hdr_begin + 4 > fstat.st_size:
                RESULT.warning("Cache file too small for header")
                return None
            hdr_size = struct.unpack(">L", read_obj.read(4))[0]
            hdr_end = read_obj.tell() + hdr_size
            if hdr_size < 10:
                RESULT.warning("Cache file structure too old")
                return None
            if hdr_end > fstat.st_size:
                RESULT.warning("Invalid header size in cache file")
                return None
            tstamp = struct.unpack(">Q", read_obj.read(8))[0]
            etag = read_obj.read(struct.unpack(">H", read_obj.read(2))[0]).decode()
            last_modified = datetime.datetime.fromtimestamp(tstamp, tz=datetime.UTC)
            last_update = datetime.datetime.fromtimestamp(fstat.st_mtime, tz=datetime.UTC)
            age = datetime.datetime.now(tz=datetime.UTC) - last_update
            read_obj.seek(hdr_end, os.SEEK_SET)
            data = read_obj.read()
            return CacheEntry(
                url=url,
                last_modified=last_modified,
                etag=etag,
                age=age,
                data=data,
            )
        except EOFError:
            RESULT.warning(f"Unexpected EOF in cache file")
            return None

    @staticmethod
    def _key(url: str) -> str:
        return base64.urlsafe_b64encode(hashlib.sha256(url.encode()).digest()).rstrip(b"=").decode()

    @staticmethod
    def get(args: Arguments, url: str) -> CacheEntry | None:
        assert not "\n" in url
        key = CacheEntry._key(url)
        cache_base_dir = args.cache_dir or DEFAULT_NAGIOS_STATE_DIR
        cache_dir = os.path.join(cache_base_dir, "check_tls_service")
        if not os.path.isdir(cache_dir):
            RESULT.debug(f"cache directory doesn't exist yet")
            return None
        try:
            with open(os.path.join(cache_dir, key), "rb") as read_obj:
                obj = CacheEntry._read(read_obj)
        except (FileNotFoundError, PermissionError) as exc:
            RESULT.debug(f"Couldn't open cache file: {exc}")
            return None
        if obj and obj.url != url:
            RESULT.warning(f"URL mismatch in cache entry: {obj.url!r} != {url!r}")
            return None
        return obj

    @staticmethod
    def touch(args: Arguments, url: str) -> None:
        assert not "\n" in url
        key = CacheEntry._key(url)
        cache_base_dir = args.cache_dir or DEFAULT_NAGIOS_STATE_DIR
        cache_dir = os.path.join(cache_base_dir, "check_tls_service")
        try:
            os.utime(os.path.join(cache_dir, key))
        except OSError:
            pass

    @staticmethod
    def put(args: Arguments, url: str, etag: str, data: bytes, last_mtime: datetime.datetime) -> None:
        assert not "\n" in url
        if not args.cache_dir and os.getuid() == 0:
            RESULT.debug(f"Not writing default cache dir as root")
            # enable cache for root only with explicit cache dir
            return None
        key = CacheEntry._key(url)
        cache_base_dir = args.cache_dir or DEFAULT_NAGIOS_STATE_DIR
        cache_dir = os.path.join(cache_base_dir, "check_tls_service")

        @contextlib.contextmanager
        def with_cache_dir() -> typing.Generator[int | None]:
            fd_cache_dir: int | None = None
            try:
                fd_cache_dir = os.open(cache_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_PATH)
            except FileNotFoundError:
                pass
            if fd_cache_dir is None:
                try:
                    os.makedirs(cache_dir, exist_ok=True)
                except OSError as exc:
                    RESULT.debug(f"Can't create cache dir {cache_dir!r}: {exc}")
                try:
                    fd_cache_dir = os.open(cache_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_PATH)
                except OSError as exc:
                    RESULT.debug(f"Can't open cache dir {cache_dir!r}: {exc}")
            try:
                yield fd_cache_dir
            finally:
                if not fd_cache_dir is None:
                    os.close(fd_cache_dir)

        @contextlib.contextmanager
        def mkstemp(fd_cache_dir: int) -> typing.Generator[typing.BinaryIO | None]:
            flags = os.O_CREAT | os.O_CLOEXEC | os.O_EXCL | os.O_NOFOLLOW | os.O_WRONLY
            mode = 0o444
            while True:
                suffix = secrets.token_urlsafe(6)
                tmp_name = f"{key}.{suffix}~"
                try:
                    fd = os.open(tmp_name, flags=flags, mode=mode, dir_fd=fd_cache_dir)
                except FileExistsError:
                    continue
                except OSError as exc:
                    RESULT.debug(f"Can't create temporary cache file: {exc}")
                    yield None
                    return
                break

            try:
                with open(fd, mode="wb") as tmp_file:
                    yield tmp_file
            finally:
                if sys.exception() is None:
                    try:
                        os.rename(tmp_name, key, src_dir_fd=fd_cache_dir, dst_dir_fd=fd_cache_dir)
                        return
                    except Exception as exc:
                        RESULT.warning(f"Couldn't update cache file (renaming tmp file): {exc}")
                        pass
                try:
                    os.unlink(tmp_name, dir_fd=fd_cache_dir)
                except Exception as exc:
                    # what are we gonna do?...
                    RESULT.warning(f"Can't cleanup tmp file: {exc}")
                    pass

        etag_bytes = etag.encode()
        if len(etag_bytes) > 65535:
            etag_bytes = b""  # etag too long
        with with_cache_dir() as fd_cache_dir:
            if fd_cache_dir is None:
                return
            with mkstemp(fd_cache_dir) as tmp_file:
                if tmp_file is None:
                    return
                header = struct.pack(">Q", int(last_mtime.timestamp())) + struct.pack(">H", len(etag_bytes)) + etag_bytes
                tmp_file.write(url.encode() + b"\n" + struct.pack(">L", len(header)) + header)
                tmp_file.write(data)


class HTTPErrorProcessor(urllib.request.HTTPErrorProcessor):
    def http_response(self, request, response):
        # need to accept 304 (outside 2xx)
        return response


def cached_download(args: Arguments, url: str) -> bytes | None:
    entry = CacheEntry.get(args, url)
    headers: dict[str, str] = {}
    if not entry is None:
        # if entry.age <= datetime.timedelta(hours=1):
        #     RESULT.debug("Using cached CRL download - file recent enough")
        #     return entry.data
        headers["if-modified-since"] = entry.last_modified.strftime("%a, %d %b %Y %H:%M:%S GMT")
        if entry.etag:
            headers["if-none-match"] = entry.etag

    opener = urllib.request.build_opener(HTTPErrorProcessor)
    resp = opener.open(urllib.request.Request(url, headers=headers))
    with resp as resp_file:
        if not entry is None and resp.status == 304:
            RESULT.debug("Using cached CRL download - 304 Not modified")
            CacheEntry.touch(args, url)  # mark file as "fresh"
            return entry.data
        if resp.status != 200:
            RESULT.message(f"Failed downloading {url}: status {resp.status}")
            return None
        try:
            last_mtime = datetime.datetime.strptime(resp.headers["last-modified"], "%a, %d %b %Y %H:%M:%S %Z")
        except Exception:
            last_mtime = datetime.datetime.now(tz=datetime.UTC)
        data = resp_file.read()
        RESULT.debug(f"Fetched {len(data)} bytes from {url}")
    CacheEntry.put(args, url, resp.headers.get("etag") or "", data, last_mtime)
    return data


def check_crl(args: Arguments, cert: cryptography.x509.Certificate, *, optional: bool = False) -> None:
    crls: list[str] = []

    crl_dps = cert.extensions.get_extension_for_class(cryptography.x509.CRLDistributionPoints)
    for crl_dp in crl_dps.value:
        RESULT.debug(f"CRL DistributionPoint: {crl_dp}")
        if not crl_dp.full_name:
            continue
        if isinstance(crl_dp.full_name[0], cryptography.x509.UniformResourceIdentifier):
            RESULT.message(f"CRL: {crl_dp.full_name[0].value}")
            crls.append(crl_dp.full_name[0].value)

    if not crls:
        if not optional:
            RESULT.critical("Missing CLR in certificate", abort=False)
        return

    for crl_url in crls:
        crl_data = cached_download(args, crl_url)
        if crl_data is None:
            continue
        RESULT.message(f"TBD: check CRL {len(crl_data)}")
        crl = cryptography.x509.load_der_x509_crl(crl_data)
        # crl.is_signature_valid(first_intermediate)
        rev = crl.get_revoked_certificate_by_serial_number(cert.serial_number)
        if rev:
            RESULT.critical(f"Certificate is revoked by CRL: {rev}", abort=False)
            return
        RESULT.debug("CRL check: good, certificate not listed")
        break
    else:
        RESULT.critical("Couldn't fetch any CLR", abort=False)


def check_chain(args: Arguments, peer_cert_and_chain: list[cryptography.x509.Certificate] | None) -> None:
    now = datetime.datetime.now(tz=datetime.UTC)

    seen_chain_certs: set[bytes] = set()

    if not peer_cert_and_chain:
        RESULT.critical("No certificates found")

    for cr_ndx, cr_cert in enumerate(peer_cert_and_chain):
        cr_subject = cr_cert.subject.rfc4514_string()
        cr_subject_cn_l = cr_cert.subject.get_attributes_for_oid(cryptography.x509.oid.NameOID.COMMON_NAME)
        cr_subject_cn = cr_subject_cn_l and cr_subject_cn_l[0].value or cr_subject
        cr_issuer_o_l = cr_cert.issuer.get_attributes_for_oid(cryptography.x509.oid.NameOID.ORGANIZATION_NAME)
        cr_issuer_o = cr_issuer_o_l and cr_issuer_o_l[0].value or cr_cert.issuer.rfc4514_string()
        cr_valid = (cr_cert.not_valid_after_utc - now)
        cr_valid_days = cr_valid.total_seconds() / 86400.0

        RESULT.performance(f"days_chain_elem{cr_ndx+1}", f"{cr_valid.days};{args.warning};{args.critical};;")

        # check for duplicates in chain
        if cr_cert.tbs_certificate_bytes in seen_chain_certs:
            msg = f"Chain cert #{cr_ndx} is a duplicate of an earlier certificate: {cr_subject}"
            if args.check_chain:
                RESULT.critical(msg, abort=False)
            else:
                RESULT.debug(msg)
            continue  # skip other checks
        seen_chain_certs.add(cr_cert.tbs_certificate_bytes)

        RESULT.message(f"Chain cert #{cr_ndx}: {cr_cert.not_valid_before_utc} - {cr_cert.not_valid_after_utc}, expires in {cr_valid.days} days: {cr_subject}")

        # checks against peer certificate
        if cr_ndx == 0:
            verify_peer_names(args, cr_cert)
            check_crl(args, cr_cert)

            # TODO: check peer certificate "purpose" (key usage) and whether key usage is marked as critical extension
            # RESULT.debug(cr_cert.extensions.get_extension_for_class(cryptography.x509.KeyUsage))
            # RESULT.debug(cr_cert.extensions.get_extension_for_class(cryptography.x509.ExtendedKeyUsage))

            # CA/Browser Forum Baseline requirements: 6.3.2 Certificate operational periods and key pair usage periods
            if args.maximum_validity != -1:
                total_valid_days = (cr_cert.not_valid_after_utc - cr_cert.not_valid_before_utc).days
                if total_valid_days > args.maximum_validity:
                    RESULT.critical(f"Peer certificate mustn't be valid for more than {args.maximum_validity} days, but is valid for {total_valid_days} days", abort=False)

            if not args.ignore_sct:  # and not args.selfsigned
                # TODO: clients must support SCTs in the TLS handshake and in OCSP too - so maybe we should allow those to succeed as well
                # (https://datatracker.ietf.org/doc/html/rfc9162#section-8.1.1)
                try:
                    pc_sct = cr_cert.extensions.get_extension_for_oid(cryptography.x509.oid.ExtensionOID.PRECERT_SIGNED_CERTIFICATE_TIMESTAMPS)
                except cryptography.x509.extensions.ExtensionNotFound:
                    RESULT.critical("Peer certificates has no Signed Certificate Timestamps (SCT)", abort=False)
                else:
                    assert isinstance(pc_sct.value, cryptography.x509.extensions.PrecertificateSignedCertificateTimestamps)
                    RESULT.debug(f"Found {len(pc_sct.value)} Signed Certificate Timestamps (SCT) in peer certificate")

        # check for root CAs in chain
        if cr_ndx > 0 and cr_cert.issuer == cr_cert.subject:
            msg = f"Chain cert #{cr_ndx}: certificate is self signed (i.e. a root CA); shouldn't be in chain: {cr_subject}"
            if args.check_chain:
                RESULT.critical(msg, abort=False)
            else:
                RESULT.debug(msg)

        # check "valid" times
        if now < cr_cert.not_valid_before_utc:
            RESULT.critical(f"Chain cert #{cr_ndx} {cr_subject} not valid yet (not valid before: {cr_cert.not_valid_before_utc})", abort=False)
        elif now > cr_cert.not_valid_after_utc:
            RESULT.critical(f"Chain cert #{cr_ndx} {cr_subject} expired (not valid after: {cr_cert.not_valid_after_utc})", abort=False)
        elif cr_valid_days < args.critical:
            RESULT.critical(f"Chain cert #{cr_ndx} {cr_subject} expires in {cr_valid.days} days (not valid after: {cr_cert.not_valid_after_utc})", abort=False)
        elif cr_valid_days < args.warning:
            RESULT.warning(f"Chain cert #{cr_ndx} {cr_subject} expires in {cr_valid.days} days (not valid after: {cr_cert.not_valid_after_utc})")

        if cr_ndx == 0 and RESULT.code is None:
            RESULT.ok(
                f"{args.host}:{args.actual_port}, {args.protocol}, "
                f"x509 certificate {cr_subject_cn!r} from {cr_issuer_o!r} "
                f"valid until {cr_cert.not_valid_after_utc} (expires in {cr_valid.days} days)"
            )


def verify_file(args: Arguments) -> None:
    with open(args.file, "rb") as file:
        file_data = file.read()
    peer_certs = []
    BEGIN = b"-----BEGIN CERTIFICATE-----"
    END = b"-----END CERTIFICATE-----"
    while True:
        try:
            begin = file_data.index(BEGIN)
            file_data = file_data[begin:]
            end = file_data.index(END) + len(END)
            peer_certs.append(cryptography.x509.load_pem_x509_certificate(file_data[:end]))
            file_data = file_data[end:]
        except ValueError:
            break
    check_chain(args, peer_certs)

    # TODO: verify against (trusted) root certs?


def main() -> None:
    # import shlex
    # RESULT.message(shlex.join(sys.argv))
    args = Arguments.parse_args()
    RESULT.debug_level = args.debug
    postprocess_args(args)

    if args.file:
        return verify_file(args)

    # SSL context
    context = OpenSSL.SSL.Context(OpenSSL.SSL.TLS_CLIENT_METHOD)
    if args.rootcert_dir or args.rootcert_file:
        context.load_verify_locations(cafile=args.rootcert_file or None, capath=args.rootcert_dir or None)
    else:
        context.set_default_verify_paths()
    context.set_verify(OpenSSL.SSL.VERIFY_PEER)

    if args.no_ssl2:
        context.set_options(OpenSSL.SSL.OP_NO_SSLv2)
    if args.no_ssl3:
        context.set_options(OpenSSL.SSL.OP_NO_SSLv3)
    if args.no_tls1:
        context.set_options(OpenSSL.SSL.OP_NO_TLSv1)
    if args.no_tls1_1:
        context.set_options(OpenSSL.SSL.OP_NO_TLSv1_1)
    if args.no_tls1_2:
        context.set_options(OpenSSL.SSL.OP_NO_TLSv1_2)
    if args.no_tls1_3:
        context.set_options(OpenSSL.SSL.OP_NO_TLSv1_3)

    if args.clientcert or args.clientkey:
        if not (args.clientcert and args.clientkey):
            RESULT.critical("must specify either both or none of client key + cert")
        context.use_certificate_chain_file(args.clientcert)
        context.use_privatekey_file(args.clientkey)

    conn = tls_connect(args, context)
    conn.do_handshake()

    # test_renegotiation(args, context)

    check_chain(args, conn.get_peer_cert_chain())


with NagiosResult.run() as RESULT:
    main()
