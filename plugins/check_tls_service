def postprocess_args(args: Arguments) -> None:
    if args.ipv4 and args.ipv6:
        RESULT.critical("Can't force use both IPv4 and IPv6")

    if args.ignore_maximum_validity:
        if args.maximum_validity != -1:
            RESULT.critical("Can't use both --ignore-maximum-validity and --maximum-validity")
    elif args.maximum_validity == -1 and args.protocol == Protocol.HTTPS:
        args.maximum_validity = 367

    if args.rootcert:
        if args.rootcert_dir or args.rootcert_file:
            RESULT.critical("Can't use bother --rootcert and --rootcert-dir or --rootcert-file")
        if os.path.isdir(args.rootcert):
            args.rootcert_dir = args.rootcert
        else:
            args.rootcert_file = args.rootcert

    if not args.ignore_host_cn and args.host:
        try:
            ipaddress.ip_address(args.host)
        except ValueError:
            args.match = [args.host] + (args.match or [])

    if not args.match:
        # either --ignore-host-cn or args.host was an IP or verifying a file
        RESULT.critical("Must specify at least one name to match certificate against")


def connect(args: Arguments) -> socket.socket:
    timeout = 5.0  # 5 seconds connect/read/write timeout should be fine
    if args.protocol == Protocol.SMTP:
        timeout = 15.0  # smtp servers often use delayed hello as anti-spam measure
    if args.ipv4 or args.ipv6:
        if args.ipv4:
            stream = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        else:
            stream = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        stream.settimeout(timeout)
        stream.connect((args.host, args.actual_port))
    else:
        stream = socket.create_connection((args.host, args.actual_port), timeout=timeout)
    return stream


