DEFAULT_NAGIOS_STATE_DIR = "/var/lib/nagios"


class NagiosCode(enum.IntEnum):
    OK = 0
    WARNING = 1
    CRITICAL = 2
    UNKNOWN = 3


class NagiosAbort(BaseException):
    pass


class NagiosResult:
    def __init__(self) -> None:
        self.code: NagiosCode | None = None
        self.headline: str = ""
        self.messages: list[str] = []
        self.performances: list[str] = []
        self.debug_level = 0

    def performance(self, label: str, value: str) -> None:
        assert not " " in value
        assert not "=" in label
        if " " in label or "'" in label:
            label = "'" + label.replace("'", "''") + "'"
        self.performances.append(f"{label}={value}")

    def _set_code(self, code: NagiosCode, headline: str, *, prefix_code: bool = False) -> None:
        self.code = code
        if headline:
            self.headline = f"{code.name} - {headline}"
        else:
            self.headline = code.name

    def ok(self, msg: str, *, prefix_code: bool = False) -> None:
        if self.code is None:
            self._set_code(NagiosCode.OK, msg, prefix_code=prefix_code)

    def message(self, msg: str, code: NagiosCode | None = None) -> None:
        if not code is None:
            if (
                self.code is None  # no code yet
                or (code != NagiosCode.UNKNOWN and code > self.code) # "worse" code than we had before
                or (code == NagiosCode.UNKNOWN and self.code == NagiosCode.OK) # UNKNOWN worse than OK
            ):
                self._set_code(code, msg)
        self.messages.append(msg)

    def warning(self, msg: str) -> None:
        self.message(msg=msg, code=NagiosCode.WARNING)

    @typing.overload
    def critical(self, msg: str) -> typing.NoReturn:
        ...
    @typing.overload
    def critical(self, msg: str, *, abort: typing.Literal[True]) -> typing.NoReturn:
        ...
    @typing.overload
    def critical(self, msg: str, *, abort: bool) -> None:
        ...
    def critical(self, msg, *, abort=True) -> None:
        self.message(msg=msg, code=NagiosCode.CRITICAL)
        if abort:
            raise NagiosAbort()

    def debug(self, msg: str | typing.Callable[[], str], *, level: int = 1) -> None:
        if level > self.debug_level:
            return
        if not isinstance(msg, str):
            msg = msg()
        self.messages.append(msg)

    def finish(self) -> typing.NoReturn:
        if self.code is None:
            self._set_code(NagiosCode.OK, "")
        assert not self.code is None
        print(self.headline.replace("|", "_") + "|" + " ".join(self.performances))
        for msg in self.messages:
            print(msg)
        sys.exit(int(self.code))

    @staticmethod
    @contextlib.contextmanager
    def run() -> typing.Generator[NagiosResult, None, None]:
        result = NagiosResult()
        try:
            yield result
        except NagiosAbort:
            pass
        except (KeyboardInterrupt, InterruptedError):
            result.critical("Interrupted", abort=False)
        except Exception as e:
            import io
            buffer = io.StringIO()
            result.critical(f"UNCAUGHT EXCEPTION: {e}", abort=False)
            traceback.print_exception(e, file=buffer)
            result.messages.extend(buffer.getvalue().splitlines())
        result.finish()


# ASN.1 helpers
@dataclasses.dataclass
class ASN1Object:
    tag: int
    value: list[ASN1Object] | bytes

    # UNIVERSAL = 0x00
    APPLICATION: typing.ClassVar[int] = 0x40
    CONTEXT_SPECIFIC: typing.ClassVar[int] = 0x80
    PRIVATE: typing.ClassVar[int] = 0xc0

    INTEGER: typing.ClassVar[int] = 0x02
    OCTET_STRING: typing.ClassVar[int] = 0x04
    ENUMERATED: typing.ClassVar[int] = 0x0a
    SEQUENCE: typing.ClassVar[int] = 0x10

    @property
    def constructed(self) -> bool:
        return isinstance(self.value, list)

    @staticmethod
    def from_int(value: int, *, tag: int = INTEGER, signed: bool = True) -> ASN1Object:
        bits = value.bit_count()
        if signed:
            bits += 1
        else:
            assert value >= 0
        len = (bits + 7) // 8
        return ASN1Object(tag=tag, value=value.to_bytes(len, signed=signed))

    def data_as_int(self) -> int:
        assert isinstance(self.value, bytes)
        return int.from_bytes(self.value, signed=True)

    @staticmethod
    def decode(data: bytes | memoryview) -> ASN1Object:
        data, obj = ASN1Object.decode_step(memoryview(data))
        if data:
            raise ValueError("Too much data")
        return obj

    @staticmethod
    def decode_step(data: memoryview) -> tuple[memoryview, ASN1Object]:
        def find_nul_nul(data: memoryview) -> int | None:
            for ndx in range(len(data) - 1):
                if data[ndx] == 0 and data[ndx + 1] == 0:
                    return ndx
            return None

        if len(data) < 2:
            raise EOFError()
        tag = data[0]
        constructed = (tag & 0x20) != 0
        tag = tag & ~0x20  # drop constructed/primitive flag from tag
        payload_offset = 2
        payload_skip = 0
        payload_len: int
        if data[1] & 0x80:
            len_len = data[1] & ~0x80
            if len_len == 0:
                end: int | None = find_nul_nul(data)
                if end is None:
                    raise EOFError("missing NUL NUL terminator for indefinitive form")
                payload_len = end - 2
                payload_skip = 2
            else:
                if len(data) < 2 + len_len:
                    raise EOFError()
                payload_offset += len_len
                payload_len = int.from_bytes(data[2:][:len_len])
        else:
            payload_len = data[1]
        if len(data) < payload_offset + payload_len + payload_skip:
            raise EOFError()
        payload_view = data[payload_offset:][:payload_len]
        data = data[payload_offset + payload_len + payload_skip:]
        value: bytes | list[ASN1Object]
        if constructed:
            value = ASN1Object._decode_list(payload_view)
        else:
            value = bytes(payload_view)
        return (data, ASN1Object(tag=tag, value=value))

    @staticmethod
    def _decode_list(data: memoryview) -> list[ASN1Object]:
        result: list[ASN1Object] = []
        while data:
            data, obj = ASN1Object.decode_step(data)
            result.append(obj)
        return result

    @staticmethod
    def _encode_len(len: int) -> bytes:
        assert len >= 0
        if len < 0x80:
            return len.to_bytes(1)
        len_len = (len.bit_length() + 7) // 8
        assert len_len < 0x80
        return (len_len + 0x80).to_bytes(1) + len.to_bytes(len_len)

    def encode_into(self, buffer: bytearray) -> None:
        tag = self.tag | (0x20 if self.constructed else 0)
        buffer.append(tag)
        if isinstance(self.value, list):
            offset = len(buffer)
            for value in self.value:
                value.encode_into(buffer)
            # insert length before nested data
            buffer[offset:offset] = self._encode_len(len(buffer) - offset)
        else:
            buffer.extend(self._encode_len(len(self.value)))
            buffer.extend(self.value)

    def encode(self) -> bytearray:
        buffer = bytearray()
        self.encode_into(buffer)
        return buffer


class Protocol(enum.StrEnum):
    SMTP = "smtp"
    SMTPS = "smtps"
    POP3 = "pop3"
    DNS = "dns"
    FTP = "ftp"  # alias: "ftps"
    POP3S = "pop3s"
    LDAP = "ldap"
    LDAPS = "ldaps"
    IMAP = "imap"
    IMAPS = "imaps"
    POSTGRES = "postgres"  # alias "postgresql"
    SIEVE = "sieve"
    # "http" used to check https on port 80; if you want that just specify port 80
    # HTTP = "http"
    HTTPS = "https"
    H2 = "h2"
    H3 = "h3"
    MQTTS = "mqtts"
    MYSQL = "mysql"
    SIPS = "sips"
    XMPP = "xmpp"
    XMPP_SERVER = "xmpp-server"
    TDS = "tds"

    @staticmethod
    def from_str(name: str) -> Protocol:
        # handle aliases
        if name == "ftps":
            return Protocol.FTP
        if name == "postgresql":
            return Protocol.POSTGRES
        return Protocol(name)

    @staticmethod
    def starttls_smtp(args: Arguments, stream: BufferedSocket) -> None:
        def get_reply() -> tuple[int, list[bytes]]:
            lines: list[bytes] = []
            code: int | None = None
            while True:
                line = stream.recv_line(1024, separator=b"\r\n")
                if len(line) > 512:
                    # https://datatracker.ietf.org/doc/html/rfc5321#section-4.5.3.1.5
                    raise ValueError(f"Invalid SMTP reply line {line!r} (too long)")
                if len(line) < 3 or not line[:3].isdigit():
                    raise ValueError(f"Invalid SMTP reply line {line!r} (missing 3-digit code)")
                line_code = int(line[:3])
                if code is None:
                    code = line_code
                elif code != line_code:
                    # https://datatracker.ietf.org/doc/html/rfc5321#section-4.2.1 (last paragraph)
                    raise ValueError(f"Different codes in SMTP multiline reply; first code was {code}, got {line!r}")
                if len(line) == 3:
                    # servers should append SP even when there is no text
                    lines.append(b'')
                else:
                    # got at least 4 bytes; remember text
                    lines.append(line[4:].rstrip(b'\r\n'))
                    ind = line[3:4]
                    if ind == b' ':
                        break  # final reply line
                    elif ind != b'-':
                        raise ValueError(f"Invalid response line {line!r} (missing SP or '-' after code)")
                if len(lines) >= 30:
                    raise ValueError(f"Too many SMTP reply lines")
            return (code, lines)

        # wait for greeting from server
        greeting_code, greeting_lines = get_reply()
        if greeting_code != 220:
            raise ValueError(f"Unexpected SMTP greeting (!= 220): {greeting_code} {greeting_lines}")

        # send EHLO
        stream.sendall(f"EHLO {socket.gethostname()}\r\n".encode())
        ehlo_code, ehlo_lines = get_reply()
        if ehlo_code != 250:
            raise ValueError(f"Unexpected SMTP EHLO reply (!= 250): {ehlo_code} {ehlo_lines}")
        for ehlo_line in ehlo_lines[1:]:  # search for keywords, but not in first reply line
            if ehlo_line.split(b' ', maxsplit=1)[0] == b"STARTTLS":
                break
        else:
            raise ValueError(f"SMTP EHLO reply didn't contain the STARTTLS keyword: {ehlo_code} {ehlo_lines}")

        # send STARTTLS
        stream.sendall(b"STARTTLS\r\n")
        starttls_code, starttls_lines = get_reply()
        if starttls_code != 220:
            raise ValueError(f"SMTP STARTTLS failed with: {starttls_code} {starttls_lines}")

    @staticmethod
    def starttls_pop3(args: Arguments, stream: BufferedSocket) -> None:
        def get_reply() -> tuple[bool, bytes]:
            # only single-line replies supported; we don't send commands that expect multi-line replies.
            line = stream.recv_line(1024, separator=b"\r\n")
            if len(line) > 512:
                # https://www.rfc-editor.org/rfc/rfc1939#section-3
                raise ValueError(f"Invalid POP3 reply line {line!r} (too long)")
            parts = line.split(b' ', maxsplit=1)
            success = (parts[0] == b"+OK")
            return (success, line.rstrip(b"\r\b"))

        greeting_ind, greeting_msg = get_reply()
        if not greeting_ind:
            raise ValueError(f"Unexpected POP3 greeting: {greeting_msg!r}")

        stream.sendall(b"STLS\r\n")
        starttls_ind, starttls_msg = get_reply()
        if not starttls_ind:
            raise ValueError(f"POP3 STARTTLS (STLS) failed: {starttls_msg!r}")

    @staticmethod
    def starttls_imap(args: Arguments, stream: BufferedSocket) -> None:
        capabilities: set[bytes] = set()

        def get_reply(expect_greeting: bool = False) -> tuple[bytes, list[bytes]]:
            nonlocal capabilities  # CAPABILITY can be received anytime
            # literals not supported
            lines: list[bytes] = []
            while True:
                line = stream.recv_line(4096, separator=b"\r\n")
                if len(line) > 2048:
                    # unclear if there is a "standard" limit?
                    raise ValueError(f"IMAP response line too long")
                tag, data = line.rstrip(b'\r\n').split(b' ', maxsplit=1)
                if tag == b'+':
                    # we don't send synchronized literals
                    raise ValueError(f"Unexpected continue response {line!r}")
                if tag == b'*':
                    if data[:4].upper().startswith(b'BYE '):
                        raise EOFError(f"Server wants to end connection: {data!r}")
                    elif data.upper().startswith(b"CAPABILITY "):
                        # might come before greeting?
                        capabilities |= set(data.upper().removeprefix(b"CAPABILITY ").split(b" "))
                    elif expect_greeting:
                        return (data, lines)
                    else:
                        lines.append(data)
                else:
                    # we use "." as tag for all commands
                    if expect_greeting or tag != b".":
                        raise ValueError("Unexpected response tag")
                    return (data, lines)

        greeting, _ = get_reply(expect_greeting=True)
        if not greeting.upper().startswith((b"OK ", b"PREAUTH ")):
            raise ValueError(f"Invalid IMAP greeting: {greeting!r}")

        stream.sendall(b". CAPABILITY\r\n")
        cap_reply, lines = get_reply()
        if not cap_reply.upper().startswith(b"OK "):
            raise ValueError(f"IMAP CAPABILITY failed: {cap_reply!r}")
        if not (b"STARTTLS" in capabilities):
            raise ValueError(f"IMAP STARTTLS CAPABILITY missing")

        stream.sendall(b". STARTTLS\r\n")
        starttls_reply, _ = get_reply()
        if not starttls_reply.upper().startswith(b"OK "):
            raise ValueError(f"IMAP STARTTLS failed: {starttls_reply!r}")

    @staticmethod
    def starttls_ftp(args: Arguments, stream: BufferedSocket) -> None:
        def wait_for_reply() -> tuple[int, str]:
            resp = stream.recv_line(1024)
            if len(resp) < 4 or not resp[:3].isdigit() or not resp[3] in b" -":
                RESULT.critical("Invalid FTP response", abort=False)
                RESULT.message("> " + resp.decode(errors="replace"))
                raise NagiosAbort()

            code = int(resp[:3])
            msg = resp[4:].decode(errors="replace").rstrip()

            if resp[3] == 32:  # SP
                return code, msg

            prefix = resp[:3] + b" "
            while True:
                resp = stream.recv_line(1024)
                if resp.startswith(prefix):
                    return code, msg

        def wait_for_final_reply() -> tuple[int, str]:
            while True:
                code, msg = wait_for_reply()
                if 100 <= code <= 199:
                    RESULT.debug(f"Preliminary reply: {code}: {msg}")
                    continue
                return code, msg

        conn_code, conn_msg = wait_for_final_reply()
        if not (200 <= conn_code <= 299):
            RESULT.critical(f"FTP: Failed establishing connection: {conn_code}: {conn_msg}")
        RESULT.debug(f"FTP: Connection established: {conn_code}: {conn_msg}")

        stream.sendall(b"AUTH TLS\r\n")
        tls_code, tls_msg = wait_for_final_reply()
        if tls_code != 234:
            RESULT.critical(f"FTP: Failed starting TLS: {tls_code}: {tls_msg}")
        RESULT.debug(f"FTP: Started TLS: {tls_code}: {tls_msg}")

    @staticmethod
    def starttls_xmpp(args: Arguments, stream: BufferedSocket) -> None:
        r_xml_error = re.compile(rb"<(?:[a-zA-Z0-9]+:)?error\b")
        r_xml_features_end = re.compile(rb"</(?:[a-zA-Z0-9]+:)?features\b[^>]*>|<(?:[a-zA-Z0-9]+:)?features\b[^>]*/>")
        r_xml_proceed_end = re.compile(rb"</(?:[a-zA-Z0-9]+:)?proceed\b[^>]*>|<(?:[a-zA-Z0-9]+:)?proceed\b[^>]*/>")

        def wait_for(pattern: re.Pattern[bytes]) -> bytes:
            resp = b""
            while True:
                resp += stream.recv(1024)
                if r_xml_error.search(resp):
                    RESULT.critical("XMPP stream error", abort=False)
                    RESULT.message(resp.decode(errors="replace"))
                    raise NagiosAbort()
                if pattern.search(resp):
                    return resp

        xmpp_domain = args.xmpphost or args.host
        xmpp_proto = "client" if args.protocol == Protocol.XMPP else "server"

        stream.sendall(
            (
                "<?xml version='1.0'?>"
                f"<stream:stream xmlns:stream='http://etherx.jabber.org/streams' xmlns='jabber:{xmpp_proto}' to='{xmpp_domain}' version='1.0'>"
            ).encode()
        )
        wait_for(r_xml_features_end)
        stream.sendall(b"<starttls xmlns='urn:ietf:params:xml:ns:xmpp-tls'/>")
        wait_for(r_xml_proceed_end)

    @staticmethod
    def starttls_ldap(args: Arguments, stream: BufferedSocket) -> None:
        # https://datatracker.ietf.org/doc/html/rfc4511#section-4.14

        starttls_req = ASN1Object(tag=ASN1Object.SEQUENCE, value=[ # LDAPMessage
            # messageID MessageID (INTEGER)
            ASN1Object.from_int(1),
            # extendedReq ExtendedRequest (APPLICATION [23])
            ASN1Object(tag=ASN1Object.APPLICATION | 23, value=[
                # requestName [0] LDAPOID
                ASN1Object(tag=ASN1Object.CONTEXT_SPECIFIC or 0, value=b"1.3.6.1.4.1.1466.20037")
            ])
        ])
        stream.sendall(starttls_req.encode())

        while True:
            buffer = stream.peek_further()
            try:
                rem, reply = ASN1Object.decode_step(memoryview(buffer))
            except EOFError:
                continue  # need more data
            else:
                stream.recv(len(buffer) - len(rem))  # remove used data from buffer
                break

        if (
            reply.tag != ASN1Object.SEQUENCE or not reply.constructed
            or len(reply.value) != 2
            or not isinstance(reply.value[0], ASN1Object)
            or not isinstance(reply.value[1], ASN1Object)
            or reply.value[0].tag != ASN1Object.INTEGER or reply.value[0].data_as_int() != 1  # messageID == 1
            or reply.value[1].tag != (ASN1Object.APPLICATION | 24) or not reply.value[1].constructed or len(reply.value[1].value) < 3 # extendedResp
            or not isinstance(reply.value[1].value[0], ASN1Object)
            or not isinstance(reply.value[1].value[2], ASN1Object)
            or reply.value[1].value[0].constructed  # primitive resultCode
            or reply.value[1].value[0].tag != ASN1Object.ENUMERATED # resultCode
            or reply.value[1].value[2].constructed  # primitive diagnosticMessage
            or reply.value[1].value[2].tag != ASN1Object.OCTET_STRING  # diagnosticMessage
        ):
            RESULT.critical("Invalid LDAP reply - STARTTLS not working")

        if reply.value[1].value[0].data_as_int() != 0:
            # extract message
            if isinstance(reply.value[1].value[2].value, bytes):
                msg = reply.value[1].value[2].value.decode(errors="replace")
                RESULT.critical(f"LDAP reply with non-success resultCode - STARTTLS not supported ({msg!r})")
            else:
                RESULT.critical(f"LDAP reply with non-success resultCode and invalid message")
        # could check reply.value[1].value[3] for CONTEXT-SPECIFIC primitive TAG 10 contain STARTLS OID... but status should be good enough?

    @staticmethod
    def starttls_sieve(args: Arguments, stream: BufferedSocket) -> None:
        supports_starttls = False
        while True:
            resp = stream.recv_line(1024).rstrip().upper().decode(errors='replace')
            if resp.startswith("OK"):
                break
            RESULT.debug(f"> SIEVE capability: {resp}")
            supports_starttls = supports_starttls or resp.startswith('"STARTTLS"')
            if not resp.startswith('"'):
                RESULT.critical(f"SIEVE: failed establishing connection: {resp}")
        if not supports_starttls:
            RESULT.critical(f"SIEVE: missing STARTTLS capability")
        RESULT.debug(f"> SIEVE: established connection: {resp}")
        stream.sendall(b"STARTTLS\r\n")
        resp = stream.recv_line(1024).rstrip().upper().decode(errors='replace')
        if not resp.startswith("OK"):
            RESULT.critical(f"SIEVE: failed STARTTLS: {resp}")
        RESULT.debug(f"> SIEVE: started STARTTLS: {resp}")

    @staticmethod
    def starttls_postgres(args: Arguments, stream: BufferedSocket) -> None:
        stream.sendall(b"\x00\x00\x00\x08\x04\xd2\x16\x2f")  # SSL request
        resp = stream.recv(1)
        if resp != b"S":
            RESULT.critical("postgres: SSL request rejected")

    @staticmethod
    def starttls_mysql(args: Arguments, stream: BufferedSocket) -> None:
        seq_id = 1

        def recv() -> tuple[int, bytes]:
            resp_hdr = stream.recv_exact(4)
            resp_len, = struct.unpack("<L", resp_hdr[:3] + b"\x00")
            assert resp_len < 2**24 - 1
            resp_id = resp_hdr[3]
            return resp_id, stream.recv_exact(resp_len)

        def send(payload: bytes) -> None:
            nonlocal seq_id
            assert len(payload) < 2**24 - 1
            hdr = struct.pack("<L", len(payload))[:3] + struct.pack("<B", seq_id)
            seq_id = (seq_id + 1) & 0xff
            stream.sendall(hdr + payload)

        handshake_id, handshake = recv()
        if handshake_id != 0:
            RESULT.critical(f"mysql protocol error: expected initial handshake to have sequence id 0, got {handshake_id}")

        if handshake[0] != 10:
            RESULT.critical(f"mysql protocol not supported (version {handshake[0]}; only version 10 supported)")

        server_desc_raw, rem = handshake[1:].split(b"\x00", maxsplit=1)
        server_desc = server_desc_raw.decode(errors="replace")
        RESULT.message(f"> {server_desc}")

        if len(rem) < 20:
            RESULT.critical(f"mysql protocol error: handshake not long enough (got {handshake!r})")
        _thread_id, _auth_plug_data, _filler, cap1, _charset, _status_flags, _cap2 = struct.unpack("<LQBHBHH", rem[:20])
        if 0 == cap1 & 512:
            RESULT.critical("mysql handshake: (required) Client Protocol 4.1 not supported")
        if 0 == cap1 & 2048:
            RESULT.critical("mysql handshake: SSL not supported")

        send(
            # SSLRequest with Client Protocol 4.1
            struct.pack(
                "<LLB",
                # flags: among others CLIENT_PROTOCOL_41 (512, 0x200) and CLIENT_SSL (2048, 0x800).
                0x007faa85,
                1 << 24, # max packet size
                0x21,  # character set: utf8mb3_general_ci
            )
            + bytes(23) # filler
        )
        # TLS handshake follows immediately - no "ok" packet before.

    @staticmethod
    def starttls_tds(args: Arguments, stream: BufferedSocket) -> BufferedSocket:
        @dataclasses.dataclass(kw_only=True, slots=True)
        class TDSPacket:
            pkt_type: int
            status: int
            packet_id: int
            data: bytes

            def encode(self) -> bytes:
                header = struct.pack(">BBHHBB", self.pkt_type, self.status, len(self.data) + 8, 0, self.packet_id, 0)
                return header + self.data

            @staticmethod
            def recv(stream: BufferedSocket) -> TDSPacket:
                hdr_buf = stream.recv_exact(8)
                pkt_type, status, plen, _spid, packet_id, _window = struct.unpack(">BBHHBB", hdr_buf)
                if plen < 8:
                    RESULT.critical(f"Invalid TDS header with length {plen}")
                data = stream.recv_exact(plen - 8)
                return TDSPacket(pkt_type=pkt_type, status=status, packet_id=packet_id, data=data)

            @staticmethod
            def make_pre_login(
                *,
                options: typing.Sequence[tuple[int, bytes]],
                packet_id: int = 1,
            ) -> TDSPacket:
                offset = 5 * len(options) + 1
                data = b""
                data_buffer = b""
                for opt_id, opt_data in options:
                    data += struct.pack(">BHH", opt_id, offset, len(opt_data))
                    offset += len(opt_data)
                    data_buffer += opt_data
                data += b"\xff"  # end of options marker
                return TDSPacket(pkt_type=0x12, status=0x01, packet_id=packet_id, data=data + data_buffer)

            def pre_login_opts(self) -> dict[int, bytes]:
                # request is 0x12, but response is 0x04 (a very generic packet type)
                pos = 0
                options = {}
                while True:
                    if pos >= len(self.data):
                        RESULT.critical("Invalid PRELOGIN options, reached end of data")
                    if self.data[pos] == 0xff:
                        break
                    if pos + 5 > len(self.data):
                        RESULT.critical("Invalid PRELOGIN options, reached end of data")
                    opt_id, opt_offset, opt_len = struct.unpack(">BHH", self.data[pos:][:5])
                    if opt_offset + opt_len > len(self.data):
                        RESULT.critical("Invalid PRELOGIN options, referenced data outside of buffer")
                    pos += 5
                    options[opt_id] = self.data[opt_offset:][:opt_len]
                return options

        pre_login = TDSPacket.make_pre_login(
            options=[
                (0x00, struct.pack(">BBHH", 9, 0, 0, 0)),  # VERSION: 9.0 build 0 subbuild 0
                (0x01, b"\x01"),  # ENCRYPTION: on
                (0x02, b"\x00"),  # INSTOPT: INSTVALIDITY NUL
                # (0x03, b"\x00\x00\x00\x00"),  # THREADID
            ]
        )
        stream.sendall(pre_login.encode())
        resp = TDSPacket.recv(stream)
        if resp.packet_id != pre_login.packet_id or resp.pkt_type != 0x04:
            RESULT.critical(f"Invalid PRELOGIN response: {resp}")
        resp_opts = resp.pre_login_opts()
        raw_version = resp_opts[0x00]
        if len(raw_version) != 6:
            RESULT.critical("PRELOGIN response: Invalid version")
        version = struct.unpack(">BBHH", raw_version)
        RESULT.message(f"TDS/MSSQL Server: {version[0]}.{version[1]}, build {version[2]}, subbuild {version[3]}")
        if resp_opts.get(0x01) != b"\x01":
            RESULT.critical(f"PRELOGIN response: Encryption not on/supported (got {resp_opts.get(0x01)!r})")

        class TDSWrapper(AbstractSocket):
            def __init__(self, stream: BufferedSocket) -> None:
                super().__init__()
                self._stream = stream
                self._buffer = b""
                self._packet_id = 0x01

            def recv(self, bufsize: int, /, flags: int = 0) -> bytes:
                if self._buffer:
                    data, self._buffer = self._buffer, b""
                    return data
                pkt = TDSPacket.recv(self._stream)
                if pkt.pkt_type != 0x12:
                    RESULT.critical("TLS stream must be wrapped in PRELOGIN packets")
                if len(pkt.data) > bufsize:
                    data, self._buffer = pkt.data[:bufsize], pkt.data[bufsize:]
                    return data
                return pkt.data

            def sendall(self, data: bytes, /, flags: int = 0) -> None:
                self._packet_id = (self._packet_id + 0x01) & 0xff
                self._stream.sendall(TDSPacket(pkt_type=0x12, status=0x01, packet_id=self._packet_id, data=data).encode(), flags=flags)

            def close(self) -> None:
                self._stream.close()

            def shutdown(self, how: int) -> None:
                self._stream.shutdown(how)

        return BufferedSocket(TDSWrapper(stream))

    @staticmethod
    def _unsupported_starttls(args: Arguments, stream: BufferedSocket) -> None:
        raise RuntimeError(f"Unsupported STARTTLS protocol {args.protocol}")

    def starttls(self) -> typing.Callable[[Arguments, BufferedSocket], BufferedSocket | None] | None:
        match self:
            case Protocol.SMTP:
                return self.starttls_smtp
            case Protocol.POP3:
